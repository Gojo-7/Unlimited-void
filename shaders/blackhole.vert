uniform float uTime;

varying vec3 vWorldPosition;
varying vec3 vNormal;
varying vec2 vUv;
varying float vFresnel;

void main(){

    //////////////////////////////////////////////////////////
    // UV
    //////////////////////////////////////////////////////////

    vUv = uv;

    //////////////////////////////////////////////////////////
    // POSITION
    //////////////////////////////////////////////////////////

    vec3 pos = position;

    //////////////////////////////////////////////////////////
    // EVENT HORIZON BREATHING
    //////////////////////////////////////////////////////////

    float pulse =

        sin(

            uTime * 0.8 +

            length(position) * 4.0

        ) * 0.02;

    pos +=

        normal *

        pulse;

    //////////////////////////////////////////////////////////
    // WORLD POSITION
    //////////////////////////////////////////////////////////

    vec4 worldPosition =

        modelMatrix *

        vec4(

            pos,

            1.0

        );

    vWorldPosition =

        worldPosition.xyz;

    //////////////////////////////////////////////////////////
    // WORLD NORMAL
    //////////////////////////////////////////////////////////

    vec3 worldNormal =

        normalize(

            mat3(modelMatrix) *

            normal

        );

    vNormal =

        worldNormal;

    //////////////////////////////////////////////////////////
    // VIEW DIRECTION
    //////////////////////////////////////////////////////////

    vec3 viewDirection =

        normalize(

            cameraPosition -

            worldPosition.xyz

        );

    //////////////////////////////////////////////////////////
    // FRESNEL
    //////////////////////////////////////////////////////////

    vFresnel =

        pow(

            1.0 -

            max(

                dot(

                    worldNormal,

                    viewDirection

                ),

                0.0

            ),

            4.0

        );

    //////////////////////////////////////////////////////////
    // OUTPUT
    //////////////////////////////////////////////////////////

    gl_Position =

        projectionMatrix *

        viewMatrix *

        worldPosition;

}