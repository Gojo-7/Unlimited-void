uniform float uTime;

varying vec2 vUv;
varying vec3 vPosition;
varying vec3 vNormal;
varying float vRadius;

#define PI 3.14159265359

//////////////////////////////////////////////////////////////
// HASH
//////////////////////////////////////////////////////////////

float hash(vec2 p){

    return fract(

        sin(

            dot(

                p,

                vec2(

                    127.1,
                    311.7

                )

            )

        ) * 43758.5453123

    );

}

//////////////////////////////////////////////////////////////
// NOISE
//////////////////////////////////////////////////////////////

float noise(vec2 p){

    vec2 i = floor(p);

    vec2 f = fract(p);

    float a = hash(i);
    float b = hash(i + vec2(1.0,0.0));
    float c = hash(i + vec2(0.0,1.0));
    float d = hash(i + vec2(1.0,1.0));

    vec2 u =

        f*f*(3.0-2.0*f);

    return

        mix(a,b,u.x)

        +

        (c-a)*u.y*(1.0-u.x)

        +

        (d-b)*u.x*u.y;

}

void main(){

    //////////////////////////////////////////////////////////
    // POLAR
    //////////////////////////////////////////////////////////

    vec2 p =

        vUv * 2.0 - 1.0;

    float r =

        length(p);

    float angle =

        atan(

            p.y,

            p.x

        );

    //////////////////////////////////////////////////////////
    // PLASMA FLOW
    //////////////////////////////////////////////////////////

    float flow =

        angle * 18.0 -

        uTime * 6.0 +

        noise(

            vec2(

                angle * 5.0,

                r * 12.0

            )

        ) * 8.0;

    //////////////////////////////////////////////////////////
    // FILAMENTS
    //////////////////////////////////////////////////////////

    float filaments =

        sin(

            flow +

            r * 40.0

        );

    filaments =

        filaments * 0.5 + 0.5;

    //////////////////////////////////////////////////////////
    // DENSITY
    //////////////////////////////////////////////////////////

    float density =

        smoothstep(

            1.0,

            0.35,

            r

        );

    //////////////////////////////////////////////////////////
    // COLORS
    //////////////////////////////////////////////////////////

    vec3 blue = vec3(

        0.12,
        0.35,
        1.0

    );

    vec3 cyan = vec3(

        0.45,
        0.85,
        1.0

    );

    vec3 white = vec3(

        1.0

    );

    vec3 color =

        mix(

            blue,

            cyan,

            filaments

        );

    color +=

        white *

        pow(

            filaments,

            8.0

        ) *

        0.6;

    //////////////////////////////////////////////////////////
    // ALPHA
    //////////////////////////////////////////////////////////

    float alpha =

        density *

        (0.35 + filaments * 0.65);

    if(alpha < 0.01){

        discard;

    }

    //////////////////////////////////////////////////////////
    // OUTPUT
    //////////////////////////////////////////////////////////

    gl_FragColor =

        vec4(

            color,

            alpha

        );

}