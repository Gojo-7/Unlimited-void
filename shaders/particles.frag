varying float vDepth;
varying float vAlpha;
varying vec3 vColor;

void main(){

    //////////////////////////////////////////////////////
    // POINT UV
    //////////////////////////////////////////////////////

    vec2 uv =

        gl_PointCoord * 2.0 - 1.0;

    float dist =

        length(uv);

    //////////////////////////////////////////////////////
    // DISC SHAPE
    //////////////////////////////////////////////////////

    float disc =

        smoothstep(

            1.0,
            0.0,
            dist

        );

    //////////////////////////////////////////////////////
    // BRIGHT CORE
    //////////////////////////////////////////////////////

    float core =

        smoothstep(

            0.45,
            0.0,
            dist

        );

    //////////////////////////////////////////////////////
    // OUTER GLOW
    //////////////////////////////////////////////////////

    float glow =

        exp(

            -dist * dist * 5.5

        );

    //////////////////////////////////////////////////////
    // RIM
    //////////////////////////////////////////////////////

    float rim =

        smoothstep(

            0.95,
            0.65,
            dist

        ) *

        0.25;

    //////////////////////////////////////////////////////
    // FINAL COLOR
    //////////////////////////////////////////////////////

    vec3 color =

        vColor;

    color +=

        vec3(

            0.35,
            0.60,
            1.00

        ) *

        glow *

        vDepth;

    color +=

        vec3(1.0) *

        core *

        0.9;

    color +=

        vec3(

            0.45,
            0.80,
            1.00

        ) *

        rim;

    //////////////////////////////////////////////////////
    // ALPHA
    //////////////////////////////////////////////////////

    float alpha =

        disc *

        glow *

        vAlpha;

    alpha *=

        mix(

            0.35,

            1.0,

            vDepth

        );

    //////////////////////////////////////////////////////
    // DISCARD
    //////////////////////////////////////////////////////

    if(alpha < 0.01){

        discard;

    }

    //////////////////////////////////////////////////////
    // OUTPUT
    //////////////////////////////////////////////////////

    gl_FragColor =

        vec4(

            color,

            alpha

        );

}