uniform float uTime;
uniform float uSize;

attribute float aScale;

varying float vDepth;
varying float vAlpha;
varying vec3 vColor;

void main(){

    //////////////////////////////////////////////////////
    // LOCAL POSITION
    //////////////////////////////////////////////////////

    vec3 pos = position;

    //////////////////////////////////////////////////////
    // RADIUS
    //////////////////////////////////////////////////////

    float radius = length(pos.xz);

    //////////////////////////////////////////////////////
    // SPIRAL ROTATION
    //////////////////////////////////////////////////////

    float angle =

        atan(
            pos.z,
            pos.x
        );

    angle +=

        uTime *

        (0.25 + 5.0/(radius+5.0));

    //////////////////////////////////////////////////////
    // INWARD MOTION
    //////////////////////////////////////////////////////

    radius -=

        mod(
            uTime*4.0 +
            radius*0.03,
            150.0
        )*0.18;

    if(radius < 6.0){

        radius += 160.0;

    }

    //////////////////////////////////////////////////////
    // TURBULENCE
    //////////////////////////////////////////////////////

    float wave =

        sin(

            angle*6.0 +

            uTime*5.0 +

            radius*0.4

        )*0.8;

    pos.x =

        cos(angle)*
        radius;

    pos.z =

        sin(angle)*
        radius;

    pos.y += wave;

    //////////////////////////////////////////////////////
    // MODEL VIEW
    //////////////////////////////////////////////////////

    vec4 mvPosition =

        modelViewMatrix *

        vec4(
            pos,
            1.0
        );

    //////////////////////////////////////////////////////
    // SIZE
    //////////////////////////////////////////////////////

    float size =

        uSize *

        aScale *

        (280.0 / -mvPosition.z);

    gl_PointSize =
        max(size,1.0);

    //////////////////////////////////////////////////////
    // DEPTH
    //////////////////////////////////////////////////////

    vDepth =

        clamp(

            1.0 -

            radius/160.0,

            0.0,

            1.0

        );

    //////////////////////////////////////////////////////
    // ALPHA
    //////////////////////////////////////////////////////

    vAlpha =

        smoothstep(

            0.0,

            10.0,

            radius

        );

    //////////////////////////////////////////////////////
    // COLOR
    //////////////////////////////////////////////////////

    vec3 outer = vec3(

        1.0,
        1.0,
        1.0

    );

    vec3 inner = vec3(

        0.60,
        0.86,
        1.0

    );

    vColor =

        mix(

            outer,

            inner,

            vDepth

        );

    //////////////////////////////////////////////////////
    // OUTPUT
    //////////////////////////////////////////////////////

    gl_Position =

        projectionMatrix *

        mvPosition;

}