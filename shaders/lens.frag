uniform float uTime;

varying vec2 vUv;
varying vec3 vWorldPosition;
varying vec3 vNormal;
varying float vFresnel;

void main(){

    //////////////////////////////////////////////////////
    // DISTANCE FROM CENTER
    //////////////////////////////////////////////////////

    float r =
        length(
            vUv - 0.5
        ) * 2.0;

    //////////////////////////////////////////////////////
    // INNER HALO
    //////////////////////////////////////////////////////

    float inner =

        smoothstep(
            0.55,
            0.15,
            r
        );

    //////////////////////////////////////////////////////
    // OUTER HALO
    //////////////////////////////////////////////////////

    float outer =

        smoothstep(
            1.15,
            0.55,
            r
        );

    //////////////////////////////////////////////////////
    // RIPPLE
    //////////////////////////////////////////////////////

    float ripple =

        sin(

            r * 40.0 -

            uTime * 5.0

        ) * 0.5 + 0.5;

    ripple *=

        smoothstep(
            1.0,
            0.25,
            r
        );

    //////////////////////////////////////////////////////
    // SWIRL
    //////////////////////////////////////////////////////

    float angle =

        atan(

            vUv.y - 0.5,

            vUv.x - 0.5

        );

    float swirl =

        sin(

            angle * 12.0 +

            uTime * 2.0 +

            r * 20.0

        ) * 0.5 + 0.5;

    //////////////////////////////////////////////////////
    // COLORS
    //////////////////////////////////////////////////////

    vec3 white = vec3(

        1.0,
        1.0,
        1.0

    );

    vec3 cyan = vec3(

        0.65,
        0.90,
        1.0

    );

    vec3 blue = vec3(

        0.25,
        0.60,
        1.0

    );

    vec3 deep = vec3(

        0.02,
        0.08,
        0.22

    );

    //////////////////////////////////////////////////////
    // COLOR MIX
    //////////////////////////////////////////////////////

    vec3 color =

        mix(
            deep,
            blue,
            outer
        );

    color =

        mix(
            color,
            cyan,
            inner
        );

    color =

        mix(
            color,
            white,
            ripple * 0.35
        );

    color +=

        swirl *
        0.08;

    //////////////////////////////////////////////////////
    // FRESNEL GLOW
    //////////////////////////////////////////////////////

    color +=

        vec3(
            0.5,
            0.75,
            1.0
        ) *

        vFresnel *

        1.6;

    //////////////////////////////////////////////////////
    // ALPHA
    //////////////////////////////////////////////////////

    float alpha =

        outer *
        0.65 +

        ripple *
        0.18 +

        vFresnel *
        0.7;

    //////////////////////////////////////////////////////
    // OUTPUT
    //////////////////////////////////////////////////////

    gl_FragColor =

        vec4(

            color,

            alpha

        );

}