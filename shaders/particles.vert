uniform float uTime;
uniform float uSize;

attribute float aScale;
attribute float aRandom;

varying float vAlpha;
varying float vDepth;
varying vec3 vColor;

#define PI 3.14159265359

void main(){

    //////////////////////////////////////////////////////////
    // LOCAL POSITION
    //////////////////////////////////////////////////////////

    vec3 pos = position;

    //////////////////////////////////////////////////////////
    // RADIUS
    //////////////////////////////////////////////////////////

    float radius = length(pos.xz);

    //////////////////////////////////////////////////////////
    // ANGLE
    //////////////////////////////////////////////////////////

    float angle = atan(
        pos.z,
        pos.x
    );

    //////////////////////////////////////////////////////////
    // DIFFERENTIAL ROTATION
    //////////////////////////////////////////////////////////

    float orbitalSpeed =

        0.15 +

        12.0 /

        (radius + 8.0);

    angle +=

        uTime *

        orbitalSpeed *

        (0.5 + aRandom);

    //////////////////////////////////////////////////////////
    // GRAVITATIONAL INFALL
    //////////////////////////////////////////////////////////

    radius -=

        mod(

            uTime *

            (2.0 + aRandom),

            220.0

        ) *

        0.16;

    if(radius < 7.0){

        radius += 220.0;

    }

    //////////////////////////////////////////////////////////
    // TURBULENCE
    //////////////////////////////////////////////////////////

    float turbulence =

        sin(

            angle * 6.0 +

            radius * 0.35 +

            uTime * 4.0 +

            aRandom * 20.0

        ) * 0.75;

    pos.x =

        cos(angle) *

        radius;

    pos.z =

        sin(angle) *

        radius;

    pos.y +=

        turbulence;

    //////////////////////////////////////////////////////////
    // MODEL VIEW
    //////////////////////////////////////////////////////////

    vec4 mvPosition =

        modelViewMatrix *

        vec4(

            pos,

            1.0

        );

    //////////////////////////////////////////////////////////
    // POINT SIZE
    //////////////////////////////////////////////////////////

    float size =

        uSize *

        aScale *

        (320.0 / -mvPosition.z);

    gl_PointSize =

        max(

            size,

            1.0

        );

    //////////////////////////////////////////////////////////
    // DEPTH
    //////////////////////////////////////////////////////////

    vDepth =

        clamp(

            1.0 -

            radius /

            220.0,

            0.0,

            1.0

        );

    //////////////////////////////////////////////////////////
    // ALPHA
    //////////////////////////////////////////////////////////

    vAlpha =

        smoothstep(

            0.0,

            12.0,

            radius

        );

    //////////////////////////////////////////////////////////
    // COLOR
    //////////////////////////////////////////////////////////

    vec3 outer = vec3(

        1.0

    );

    vec3 inner = vec3(

        0.60,
        0.88,
        1.0

    );

    vColor =

        mix(

            outer,

            inner,

            vDepth

        );

    //////////////////////////////////////////////////////////
    // OUTPUT
    //////////////////////////////////////////////////////////

    gl_Position =

        projectionMatrix *

        mvPosition;

}