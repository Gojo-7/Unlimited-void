varying float vAlpha;
varying float vDepth;
varying vec3 vColor;

void main(){

    //////////////////////////////////////////////////////////
    // POINT COORDINATES
    //////////////////////////////////////////////////////////

    vec2 uv =

        gl_PointCoord * 2.0 - 1.0;

    float radius =

        length(uv);

    //////////////////////////////////////////////////////////
    // DISC SHAPE
    //////////////////////////////////////////////////////////

    float disc =

        smoothstep(

            1.0,

            0.0,

            radius

        );

    //////////////////////////////////////////////////////////
    // BRIGHT CORE
    //////////////////////////////////////////////////////////

    float core =

        smoothstep(

            0.35,

            0.0,

            radius

        );

    //////////////////////////////////////////////////////////
    // OUTER GLOW
    //////////////////////////////////////////////////////////

    float glow =

        exp(

            -radius *

            radius *

            5.5

        );

    //////////////////////////////////////////////////////////
    // RIM LIGHT
    //////////////////////////////////////////////////////////

    float rim =

        smoothstep(

            0.95,

            0.70,

            radius

        );

    //////////////////////////////////////////////////////////
    // COLOR
    //////////////////////////////////////////////////////////

    vec3 color =

        vColor;

    color +=

        vec3(

            0.25,
            0.60,
            1.00

        ) *

        glow *

        vDepth;

    color +=

        vec3(

            1.0

        ) *

        core *

        0.85;

    color +=

        vec3(

            0.65,
            0.90,
            1.0

        ) *

        rim *

        0.25;

    //////////////////////////////////////////////////////////
    // ALPHA
    //////////////////////////////////////////////////////////

    float alpha =

        disc *

        glow *

        vAlpha;

    alpha *=

        mix(

            0.35,

            1.0,

            vDepth

        );

    //////////////////////////////////////////////////////////
    // DISCARD
    //////////////////////////////////////////////////////////

    if(alpha < 0.01){

        discard;

    }

    //////////////////////////////////////////////////////////
    // OUTPUT
    //////////////////////////////////////////////////////////

    gl_FragColor =

        vec4(

            color,

            alpha

        );

}