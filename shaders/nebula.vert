uniform float uTime;

varying vec2 vUv;
varying vec3 vWorldPosition;
varying float vDensity;
varying float vHeight;

void main(){

    //////////////////////////////////////////////////////////
    // UV
    //////////////////////////////////////////////////////////

    vUv = uv;

    //////////////////////////////////////////////////////////
    // LOCAL POSITION
    //////////////////////////////////////////////////////////

    vec3 pos = position;

    //////////////////////////////////////////////////////////
    // RADIAL DISTANCE
    //////////////////////////////////////////////////////////

    float radius =

        length(

            pos.xz

        );

    //////////////////////////////////////////////////////////
    // LARGE SCALE MOTION
    //////////////////////////////////////////////////////////

    float wave1 =

        sin(

            radius * 0.18 +

            uTime * 0.30

        ) * 2.2;

    float wave2 =

        cos(

            pos.x * 0.08 +

            uTime * 0.40

        ) * 1.3;

    float wave3 =

        sin(

            pos.z * 0.11 -

            uTime * 0.22

        ) * 1.8;

    pos.y +=

        wave1 +

        wave2 +

        wave3;

    //////////////////////////////////////////////////////////
    // GLOBAL SPIRAL
    //////////////////////////////////////////////////////////

    float theta =

        atan(

            pos.z,

            pos.x

        );

    theta +=

        uTime * 0.025 +

        radius * 0.002;

    pos.x =

        cos(theta) *

        radius;

    pos.z =

        sin(theta) *

        radius;

    //////////////////////////////////////////////////////////
    // BREATHING
    //////////////////////////////////////////////////////////

    float pulse =

        1.0 +

        sin(

            uTime * 0.22

        ) * 0.025;

    pos *= pulse;

    //////////////////////////////////////////////////////////
    // WORLD POSITION
    //////////////////////////////////////////////////////////

    vec4 worldPosition =

        modelMatrix *

        vec4(

            pos,

            1.0

        );

    vWorldPosition =

        worldPosition.xyz;

    //////////////////////////////////////////////////////////
    // HEIGHT
    //////////////////////////////////////////////////////////

    vHeight =

        pos.y;

    //////////////////////////////////////////////////////////
    // DENSITY
    //////////////////////////////////////////////////////////

    vDensity =

        smoothstep(

            220.0,

            20.0,

            radius

        );

    //////////////////////////////////////////////////////////
    // OUTPUT
    //////////////////////////////////////////////////////////

    gl_Position =

        projectionMatrix *

        viewMatrix *

        worldPosition;

}